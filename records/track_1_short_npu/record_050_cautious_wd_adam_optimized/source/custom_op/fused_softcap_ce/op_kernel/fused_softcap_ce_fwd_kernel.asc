/**
 * Derived from CANN 8.3 CrossEntropyLoss (CANN Open Software License 1.0).
 * Specialized for BF16, reduction=sum, no weight, no label smoothing.
 * Softcap is applied in UB after every BF16->FP32 CopyIn.
 */

#include "kernel_operator.h"
#include "fused_softcap_ce_tiling.h"

using namespace AscendC;

namespace {
constexpr uint32_t kBlockBytes = 32;
constexpr uint32_t kFp32PerBlock = 8;
constexpr uint32_t kReduceWorkFloats = 1024;
constexpr uint32_t kFullReduce = 8192;
constexpr uint32_t kVecRepeat = 64;
constexpr float kMinFloat = -3.4028235e+38f;
}

class FusedSoftcapCEForward {
public:
    __aicore__ inline void Init(
        GM_ADDR logits, GM_ADDR target, GM_ADDR loss, GM_ADDR logProb,
        GM_ADDR sigmoidSaved, GM_ADDR workspace, const FusedSoftcapCETilingData& tiling)
    {
        vocabSize_ = tiling.vocabSize;
        frontCoreNum_ = tiling.frontCoreNum;
        frontRows_ = tiling.frontRows;
        tailCoreNum_ = tiling.tailCoreNum;
        tailRows_ = tiling.tailRows;
        tileSize_ = tiling.tileSize;
        tileLoops_ = tiling.tileLoops;
        tileTail_ = tiling.tileTail;
        ignoreIndex_ = tiling.ignoreIndex;
        scale_ = tiling.softcapScale;
        cap_ = tiling.softcapCap;

        coreIndex_ = GetBlockIdx();
        usedCoreNum_ = frontCoreNum_ + tailCoreNum_;
        uint64_t coreElementOffset = 0;
        if (tailCoreNum_ == 0 || coreIndex_ < frontCoreNum_) {
            rows_ = frontRows_;
            startRow_ = coreIndex_ * frontRows_;
            coreElementOffset = startRow_ * vocabSize_;
        } else {
            rows_ = tailRows_;
            startRow_ = frontCoreNum_ * frontRows_ +
                (coreIndex_ - frontCoreNum_) * tailRows_;
            coreElementOffset = startRow_ * vocabSize_;
        }

        logitsGm_.SetGlobalBuffer((__gm__ bfloat16_t*)logits + coreElementOffset, rows_ * vocabSize_);
        targetGm_.SetGlobalBuffer((__gm__ int64_t*)target);
        lossGm_.SetGlobalBuffer((__gm__ bfloat16_t*)loss, 1);
        logProbGm_.SetGlobalBuffer((__gm__ bfloat16_t*)logProb + coreElementOffset, rows_ * vocabSize_);
        sigmoidGm_.SetGlobalBuffer((__gm__ bfloat16_t*)sigmoidSaved + coreElementOffset, rows_ * vocabSize_);
        workspaceGm_.SetGlobalBuffer((__gm__ float*)workspace, 64);

        pipe_.InitBuffer(inputQueue_, 1, tileSize_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(sigmoidOutQueue_, 1, tileSize_ * sizeof(bfloat16_t));
        uint64_t rowLossFloats = ((rows_ + 7) / 8) * 8;
        uint64_t calcBytes = tileSize_ * sizeof(float) +
            tileSize_ * sizeof(bfloat16_t) +
            kReduceWorkFloats * sizeof(float) +
            2 * kBlockBytes + rowLossFloats * sizeof(float);
        pipe_.InitBuffer(calcBuffer_, calcBytes);

        uint64_t offset = 0;
        castBuffer_ = calcBuffer_.GetWithOffset<float>(tileSize_, offset);
        offset += tileSize_ * sizeof(float);
        bf16Buffer_ = calcBuffer_.GetWithOffset<bfloat16_t>(tileSize_, offset);
        offset += tileSize_ * sizeof(bfloat16_t);
        reduceWork_ = calcBuffer_.GetWithOffset<float>(kReduceWorkFloats, offset);
        offset += kReduceWorkFloats * sizeof(float);
        reduceCalc_ = calcBuffer_.GetWithOffset<float>(kFp32PerBlock, offset);
        offset += kBlockBytes;
        reduceRes_ = calcBuffer_.GetWithOffset<float>(kFp32PerBlock, offset);
        offset += kBlockBytes;
        rowLoss_ = calcBuffer_.GetWithOffset<float>(rowLossFloats, offset);
        inputLocal_ = inputQueue_.AllocTensor<bfloat16_t>();
    }

    __aicore__ inline void Process()
    {
        uint64_t rowOffset = 0;
        for (uint64_t row = 0; row < rows_; ++row) {
            reduceRes_.SetValue(0, kMinFloat);
            GetRowMax(rowOffset);
            float rowMax = reduceRes_.GetValue(0);

            float expSum = 0.0f;
            GetExpSum(rowOffset, rowMax, expSum);
            reduceCalc_.SetValue(0, expSum);
            Log(reduceRes_, reduceCalc_, 1);
            PipeBarrier<PIPE_V>();
            float logSumExp = rowMax + reduceRes_.GetValue(0);

            int64_t target = targetGm_.GetValue(startRow_ + row);
            bool ignored = target == ignoreIndex_;
            uint64_t targetOffset = ignored ? UINT64_MAX : row * vocabSize_ + static_cast<uint64_t>(target);
            float targetLogProb = 0.0f;
            WriteLogProb(rowOffset, logSumExp, targetOffset, targetLogProb);
            rowLoss_.SetValue(row, ignored ? 0.0f : -targetLogProb);
            rowOffset += vocabSize_;
        }

        ReduceSum(rowLoss_, reduceWork_, reduceRes_, static_cast<uint32_t>(rows_));
        event_t eventVMTE3 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE3));
        set_flag(PIPE_V, PIPE_MTE3, eventVMTE3);
        wait_flag(PIPE_V, PIPE_MTE3, eventVMTE3);
        DataCopyExtParams scalarCopy{1, sizeof(float), 0, 0, 0};
        DataCopyPad(workspaceGm_[coreIndex_], reduceRes_, scalarCopy);
        SyncAll<true>();

        if (coreIndex_ == 0) {
            DataCopy(reduceWork_, workspaceGm_, 64);
            event_t eventMTE2V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_V));
            set_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
            wait_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
            WholeReduceSum(reduceCalc_, reduceWork_, usedCoreNum_, 1, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            Cast(bf16Buffer_, reduceCalc_, RoundMode::CAST_RINT, 1);
            event_t finalVMTE3 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE3));
            set_flag(PIPE_V, PIPE_MTE3, finalVMTE3);
            wait_flag(PIPE_V, PIPE_MTE3, finalVMTE3);
            DataCopyExtParams lossCopy{1, sizeof(bfloat16_t), 0, 0, 0};
            DataCopyPad(lossGm_, bf16Buffer_, lossCopy);
        }
        inputQueue_.FreeTensor(inputLocal_);
    }

private:
    __aicore__ inline void CopyInSoftcap(
        uint64_t offset, uint32_t len, bool saveSigmoid = false, bool saveCapped = false)
    {
        if (len % 16 == 0) {
            DataCopy(inputLocal_, logitsGm_[offset], len);
        } else {
            DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
            DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};
            DataCopyPad(inputLocal_, logitsGm_[offset], copy, pad);
        }
        event_t eventMTE2V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_V));
        set_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
        wait_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
        Cast(castBuffer_, inputLocal_, RoundMode::CAST_NONE, len);
        // inputLocal_ is persistent and reused by the next tile.  A V-pipe
        // barrier alone does not stop that tile's MTE2 copy from overwriting
        // the BF16 input before this Cast has consumed it.
        event_t eventVMTE2 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE2));
        set_flag(PIPE_V, PIPE_MTE2, eventVMTE2);
        wait_flag(PIPE_V, PIPE_MTE2, eventVMTE2);

        // The incumbent compiled pointwise graph keeps the fused expression in
        // FP32 vector arithmetic and materializes only its BF16 output.
        Muls(castBuffer_, castBuffer_, -scale_, len);
        PipeBarrier<PIPE_V>();
        Exp(castBuffer_, castBuffer_, len);
        PipeBarrier<PIPE_V>();
        Adds(castBuffer_, castBuffer_, 1.0f, len);
        PipeBarrier<PIPE_V>();
        Reciprocal(castBuffer_, castBuffer_, len);
        PipeBarrier<PIPE_V>();
        if (saveSigmoid) {
            LocalTensor<bfloat16_t> sigmoidLocal = sigmoidOutQueue_.AllocTensor<bfloat16_t>();
            Cast(sigmoidLocal, castBuffer_, RoundMode::CAST_RINT, len);
            sigmoidOutQueue_.EnQue(sigmoidLocal);
            sigmoidLocal = sigmoidOutQueue_.DeQue<bfloat16_t>();
            if (len % 16 == 0) {
                DataCopy(sigmoidGm_[offset], sigmoidLocal, len);
            } else {
                DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
                DataCopyPad(sigmoidGm_[offset], sigmoidLocal, copy);
            }
            sigmoidOutQueue_.FreeTensor(sigmoidLocal);
        }
        Muls(castBuffer_, castBuffer_, cap_, len);
        PipeBarrier<PIPE_V>();

        // Preserve the incumbent BF16 softcap boundary exactly.
        event_t eventMTE3V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE3_V));
        set_flag(PIPE_MTE3, PIPE_V, eventMTE3V);
        wait_flag(PIPE_MTE3, PIPE_V, eventMTE3V);
        Cast(bf16Buffer_, castBuffer_, RoundMode::CAST_RINT, len);
        PipeBarrier<PIPE_V>();
        if (saveCapped) {
            event_t cappedVMTE3 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE3));
            set_flag(PIPE_V, PIPE_MTE3, cappedVMTE3);
            wait_flag(PIPE_V, PIPE_MTE3, cappedVMTE3);
            if (len % 16 == 0) {
                DataCopy(logProbGm_[offset], bf16Buffer_, len);
            } else {
                DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
                DataCopyPad(logProbGm_[offset], bf16Buffer_, copy);
            }
            event_t cappedMTE3V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE3_V));
            set_flag(PIPE_MTE3, PIPE_V, cappedMTE3V);
            wait_flag(PIPE_MTE3, PIPE_V, cappedMTE3V);
        }
        Cast(castBuffer_, bf16Buffer_, RoundMode::CAST_NONE, len);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void CopyInCapped(uint64_t offset, uint32_t len)
    {
        if (len % 16 == 0) {
            DataCopy(inputLocal_, logProbGm_[offset], len);
        } else {
            DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
            DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};
            DataCopyPad(inputLocal_, logProbGm_[offset], copy, pad);
        }
        event_t eventMTE2V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE2_V));
        set_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
        wait_flag(PIPE_MTE2, PIPE_V, eventMTE2V);
        Cast(castBuffer_, inputLocal_, RoundMode::CAST_NONE, len);
        event_t eventVMTE2 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE2));
        set_flag(PIPE_V, PIPE_MTE2, eventVMTE2);
        wait_flag(PIPE_V, PIPE_MTE2, eventVMTE2);
    }

    __aicore__ inline void CopyLogProbOut(uint64_t offset, uint32_t len)
    {
        event_t eventMTE3V = static_cast<event_t>(pipe_.FetchEventID(HardEvent::MTE3_V));
        set_flag(PIPE_MTE3, PIPE_V, eventMTE3V);
        wait_flag(PIPE_MTE3, PIPE_V, eventMTE3V);
        Cast(bf16Buffer_, castBuffer_, RoundMode::CAST_RINT, len);
        event_t eventVMTE3 = static_cast<event_t>(pipe_.FetchEventID(HardEvent::V_MTE3));
        set_flag(PIPE_V, PIPE_MTE3, eventVMTE3);
        wait_flag(PIPE_V, PIPE_MTE3, eventVMTE3);
        if (len % 16 == 0) {
            DataCopy(logProbGm_[offset], bf16Buffer_, len);
        } else {
            DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
            DataCopyPad(logProbGm_[offset], bf16Buffer_, copy);
        }
    }

    __aicore__ inline void GetRowMax(uint64_t rowOffset)
    {
        uint64_t offset = rowOffset;
        for (uint64_t i = 0; i < tileLoops_; ++i) {
            CopyInSoftcap(offset, static_cast<uint32_t>(tileSize_), true, true);
            ReduceMax(castBuffer_, reduceWork_, reduceRes_, reduceCalc_, static_cast<uint32_t>(tileSize_));
            offset += tileSize_;
        }
        if (tileTail_ != 0) {
            CopyInSoftcap(offset, static_cast<uint32_t>(tileTail_), true, true);
            ReduceMax(castBuffer_, reduceWork_, reduceRes_, reduceCalc_, static_cast<uint32_t>(tileTail_));
        }
    }

    __aicore__ inline void GetExpSum(uint64_t rowOffset, float rowMax, float& sum)
    {
        uint64_t offset = rowOffset;
        for (uint64_t i = 0; i < tileLoops_; ++i) {
            CopyInCapped(offset, static_cast<uint32_t>(tileSize_));
            Adds(castBuffer_, castBuffer_, -rowMax, tileSize_);
            PipeBarrier<PIPE_V>();
            Exp(castBuffer_, castBuffer_, tileSize_);
            PipeBarrier<PIPE_V>();
            ReduceSum(castBuffer_, reduceWork_, reduceCalc_, static_cast<uint32_t>(tileSize_));
            sum += reduceCalc_.GetValue(0);
            offset += tileSize_;
        }
        if (tileTail_ != 0) {
            CopyInCapped(offset, static_cast<uint32_t>(tileTail_));
            Adds(castBuffer_, castBuffer_, -rowMax, tileTail_);
            PipeBarrier<PIPE_V>();
            Exp(castBuffer_, castBuffer_, tileTail_);
            PipeBarrier<PIPE_V>();
            ReduceSum(castBuffer_, reduceWork_, reduceCalc_, static_cast<uint32_t>(tileTail_));
            sum += reduceCalc_.GetValue(0);
        }
    }

    __aicore__ inline void WriteLogProb(
        uint64_t rowOffset, float logSumExp, uint64_t targetOffset, float& targetLogProb)
    {
        uint64_t offset = rowOffset;
        for (uint64_t i = 0; i < tileLoops_; ++i) {
            CopyInCapped(offset, static_cast<uint32_t>(tileSize_));
            Adds(castBuffer_, castBuffer_, -logSumExp, tileSize_);
            PipeBarrier<PIPE_V>();
            if (targetOffset >= offset && targetOffset < offset + tileSize_) {
                targetLogProb = castBuffer_.GetValue(targetOffset - offset);
            }
            CopyLogProbOut(offset, static_cast<uint32_t>(tileSize_));
            offset += tileSize_;
        }
        if (tileTail_ != 0) {
            CopyInCapped(offset, static_cast<uint32_t>(tileTail_));
            Adds(castBuffer_, castBuffer_, -logSumExp, tileTail_);
            PipeBarrier<PIPE_V>();
            if (targetOffset >= offset && targetOffset < offset + tileTail_) {
                targetLogProb = castBuffer_.GetValue(targetOffset - offset);
            }
            CopyLogProbOut(offset, static_cast<uint32_t>(tileTail_));
        }
    }

    __aicore__ inline void ReduceSum(
        const LocalTensor<float>& src, const LocalTensor<float>& work,
        const LocalTensor<float>& dst, uint32_t len)
    {
        if (len == kFullReduce) {
            BlockReduceSum(work, src, 128, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            BlockReduceSum(work, work, 16, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            BlockReduceSum(work, work, 2, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(dst, work, 16, 1, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            return;
        }
        uint32_t repeats = len / kVecRepeat;
        uint32_t tail = len % kVecRepeat;
        if (repeats > 0) {
            WholeReduceSum(work, src, kVecRepeat, repeats, 1, 1, 8);
            PipeBarrier<PIPE_V>();
        }
        if (tail != 0) {
            WholeReduceSum(work[repeats], src[len - tail], tail, 1, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            ++repeats;
        }
        WholeReduceSum(dst, work, repeats, 1, 1, 1, 8);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ReduceMax(
        const LocalTensor<float>& src, const LocalTensor<float>& work,
        const LocalTensor<float>& running, const LocalTensor<float>& tmp, uint32_t len)
    {
        if (len == kFullReduce) {
            BlockReduceMax(work, src, 128, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            BlockReduceMax(work, work, 16, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            BlockReduceMax(work, work, 2, 64, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            WholeReduceMax(tmp, work, 16, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        } else {
            uint32_t repeats = len / kVecRepeat;
            uint32_t tail = len % kVecRepeat;
            if (repeats > 0) {
                WholeReduceMax(work, src, kVecRepeat, repeats, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
            }
            if (tail != 0) {
                WholeReduceMax(work[repeats], src[len - tail], tail, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                ++repeats;
            }
            WholeReduceMax(tmp, work, repeats, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        Max(running, running, tmp, 1, 1, {1, 1, 1, 8, 8, 8});
        PipeBarrier<PIPE_V>();
    }

    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> inputQueue_;
    TQue<QuePosition::VECOUT, 1> sigmoidOutQueue_;
    TBuf<TPosition::VECCALC> calcBuffer_;
    GlobalTensor<bfloat16_t> logitsGm_;
    GlobalTensor<int64_t> targetGm_;
    GlobalTensor<bfloat16_t> lossGm_;
    GlobalTensor<bfloat16_t> logProbGm_;
    GlobalTensor<bfloat16_t> sigmoidGm_;
    GlobalTensor<float> workspaceGm_;
    LocalTensor<bfloat16_t> inputLocal_;
    LocalTensor<float> castBuffer_;
    LocalTensor<bfloat16_t> bf16Buffer_;
    LocalTensor<float> reduceWork_;
    LocalTensor<float> reduceCalc_;
    LocalTensor<float> reduceRes_;
    LocalTensor<float> rowLoss_;
    uint64_t vocabSize_, frontCoreNum_, frontRows_, tailCoreNum_, tailRows_;
    uint64_t tileSize_, tileLoops_, tileTail_, rows_, startRow_, usedCoreNum_;
    uint32_t coreIndex_;
    int64_t ignoreIndex_;
    float scale_, cap_;
};

extern "C" __global__ __aicore__ void fused_softcap_ce_fwd_kernel(
    GM_ADDR logits, GM_ADDR target, GM_ADDR loss, GM_ADDR logProb,
    GM_ADDR sigmoidSaved, GM_ADDR workspace, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIV_1_0);
    FusedSoftcapCETilingData data;
    auto src = reinterpret_cast<__gm__ uint8_t*>(tiling);
    auto dst = reinterpret_cast<uint8_t*>(&data);
    for (uint32_t i = 0; i < sizeof(FusedSoftcapCETilingData); ++i) {
        dst[i] = src[i];
    }
    FusedSoftcapCEForward op;
    op.Init(logits, target, loss, logProb, sigmoidSaved, workspace, data);
    op.Process();
}
