/**
 * Derived from CANN 8.3 CrossEntropyLossGrad (CANN Open Software License 1.0).
 * Fuses CE gradient and the saved-sigmoid derivative in one BF16 tile pass.
 */

#include "kernel_operator.h"
#include "fused_softcap_ce_tiling.h"

using namespace AscendC;

class FusedSoftcapCEBackward {
public:
    __aicore__ inline void Init(
        GM_ADDR gradLoss, GM_ADDR sigmoidSaved, GM_ADDR logProb, GM_ADDR target,
        GM_ADDR gradLogits, const FusedSoftcapCETilingData& tiling)
    {
        vocabSize_ = tiling.vocabSize;
        frontCoreNum_ = tiling.frontCoreNum;
        frontRows_ = tiling.frontRows;
        tailCoreNum_ = tiling.tailCoreNum;
        tailRows_ = tiling.tailRows;
        tileSize_ = tiling.tileSize;
        tileLoops_ = tiling.tileLoops;
        tileTail_ = tiling.tileTail;
        ignoreIndex_ = tiling.ignoreIndex;
        scale_ = tiling.softcapScale;
        cap_ = tiling.softcapCap;

        coreIndex_ = GetBlockIdx();
        uint64_t elementOffset = 0;
        if (tailCoreNum_ == 0 || coreIndex_ < frontCoreNum_) {
            rows_ = frontRows_;
            startRow_ = coreIndex_ * frontRows_;
        } else {
            rows_ = tailRows_;
            startRow_ = frontCoreNum_ * frontRows_ +
                (coreIndex_ - frontCoreNum_) * tailRows_;
        }
        elementOffset = startRow_ * vocabSize_;

        gradLossGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gradLoss, 1);
        sigmoidGm_.SetGlobalBuffer((__gm__ bfloat16_t*)sigmoidSaved + elementOffset, rows_ * vocabSize_);
        logProbGm_.SetGlobalBuffer((__gm__ bfloat16_t*)logProb + elementOffset, rows_ * vocabSize_);
        targetGm_.SetGlobalBuffer((__gm__ int64_t*)target);
        gradGm_.SetGlobalBuffer((__gm__ bfloat16_t*)gradLogits + elementOffset, rows_ * vocabSize_);

        pipe_.InitBuffer(sigmoidQueue_, 1, tileSize_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(logProbQueue_, 1, tileSize_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(gradQueue_, 1, tileSize_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(probBuffer_, tileSize_ * sizeof(float));
        pipe_.InitBuffer(sigmoidBuffer_, tileSize_ * sizeof(float));
        pipe_.InitBuffer(tmpBuffer_, tileSize_ * sizeof(float));
        prob_ = probBuffer_.Get<float>();
        sigmoid_ = sigmoidBuffer_.Get<float>();
        tmp_ = tmpBuffer_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        float gradScale = ToFloat(gradLossGm_.GetValue(0));
        for (uint64_t row = 0; row < rows_; ++row) {
            int64_t target = targetGm_.GetValue(startRow_ + row);
            bool ignored = target == ignoreIndex_;
            uint64_t rowOffset = row * vocabSize_;
            for (uint64_t tile = 0; tile < tileLoops_; ++tile) {
                uint64_t offset = rowOffset + tile * tileSize_;
                ComputeTile(offset, tile * tileSize_, static_cast<uint32_t>(tileSize_), target, ignored, gradScale);
            }
            if (tileTail_ != 0) {
                uint64_t offset = rowOffset + tileLoops_ * tileSize_;
                ComputeTile(offset, tileLoops_ * tileSize_, static_cast<uint32_t>(tileTail_), target, ignored, gradScale);
            }
        }
    }

private:
    __aicore__ inline void ComputeTile(
        uint64_t gmOffset, uint64_t colOffset, uint32_t len,
        int64_t target, bool ignored, float gradScale)
    {
        LocalTensor<bfloat16_t> sigmoidLocal = sigmoidQueue_.AllocTensor<bfloat16_t>();
        LocalTensor<bfloat16_t> logProbLocal = logProbQueue_.AllocTensor<bfloat16_t>();
        DataCopyExtParams copy{1, static_cast<uint32_t>(len * sizeof(bfloat16_t)), 0, 0, 0};
        DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};
        DataCopyPad(sigmoidLocal, sigmoidGm_[gmOffset], copy, pad);
        DataCopyPad(logProbLocal, logProbGm_[gmOffset], copy, pad);
        sigmoidQueue_.EnQue(sigmoidLocal);
        logProbQueue_.EnQue(logProbLocal);
        sigmoidLocal = sigmoidQueue_.DeQue<bfloat16_t>();
        logProbLocal = logProbQueue_.DeQue<bfloat16_t>();

        LocalTensor<bfloat16_t> gradLocal = gradQueue_.AllocTensor<bfloat16_t>();
        Cast(prob_, logProbLocal, RoundMode::CAST_NONE, len);
        Cast(sigmoid_, sigmoidLocal, RoundMode::CAST_NONE, len);
        PipeBarrier<PIPE_V>();
        Exp(prob_, prob_, len);
        sigmoidQueue_.FreeTensor(sigmoidLocal);
        logProbQueue_.FreeTensor(logProbLocal);
        PipeBarrier<PIPE_V>();

        // Match CANN CrossEntropyLossGrad's numerical contract: scale the
        // probability first, subtract the same scalar at the target, and
        // materialize the CE gradient in BF16 before applying softcap's
        // derivative.  Reordering gradScale across those BF16 boundaries is
        // not equivalent for the optimizer's training dynamics.
        Muls(prob_, prob_, gradScale, len);
        PipeBarrier<PIPE_V>();
        if (ignored) {
            Duplicate(prob_, 0.0f, len);
        } else if (target >= static_cast<int64_t>(colOffset) &&
                   target < static_cast<int64_t>(colOffset + len)) {
            uint32_t index = static_cast<uint32_t>(target - static_cast<int64_t>(colOffset));
            prob_.SetValue(index, prob_.GetValue(index) - gradScale);
        }
        Cast(gradLocal, prob_, RoundMode::CAST_RINT, len);
        PipeBarrier<PIPE_V>();
        Cast(prob_, gradLocal, RoundMode::CAST_NONE, len);
        PipeBarrier<PIPE_V>();

        Muls(tmp_, sigmoid_, -1.0f, len);
        PipeBarrier<PIPE_V>();
        Adds(tmp_, tmp_, 1.0f, len);
        PipeBarrier<PIPE_V>();
        Mul(sigmoid_, sigmoid_, tmp_, len);
        PipeBarrier<PIPE_V>();
        Muls(sigmoid_, sigmoid_, cap_ * scale_, len);
        PipeBarrier<PIPE_V>();
        Mul(prob_, prob_, sigmoid_, len);
        PipeBarrier<PIPE_V>();
        Cast(gradLocal, prob_, RoundMode::CAST_RINT, len);
        gradQueue_.EnQue(gradLocal);

        gradLocal = gradQueue_.DeQue<bfloat16_t>();
        DataCopyPad(gradGm_[gmOffset], gradLocal, copy);
        gradQueue_.FreeTensor(gradLocal);
    }

    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> sigmoidQueue_;
    TQue<QuePosition::VECIN, 1> logProbQueue_;
    TQue<QuePosition::VECOUT, 1> gradQueue_;
    TBuf<TPosition::VECCALC> probBuffer_;
    TBuf<TPosition::VECCALC> sigmoidBuffer_;
    TBuf<TPosition::VECCALC> tmpBuffer_;
    GlobalTensor<bfloat16_t> gradLossGm_, sigmoidGm_, logProbGm_, gradGm_;
    GlobalTensor<int64_t> targetGm_;
    LocalTensor<float> prob_, sigmoid_, tmp_;
    uint64_t vocabSize_, frontCoreNum_, frontRows_, tailCoreNum_, tailRows_;
    uint64_t tileSize_, tileLoops_, tileTail_, rows_, startRow_;
    uint32_t coreIndex_;
    int64_t ignoreIndex_;
    float scale_, cap_;
};

extern "C" __global__ __aicore__ void fused_softcap_ce_bwd_kernel(
    GM_ADDR gradLoss, GM_ADDR sigmoidSaved, GM_ADDR logProb, GM_ADDR target,
    GM_ADDR gradLogits, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIV_1_0);
    FusedSoftcapCETilingData data;
    auto src = reinterpret_cast<__gm__ uint8_t*>(tiling);
    auto dst = reinterpret_cast<uint8_t*>(&data);
    for (uint32_t i = 0; i < sizeof(FusedSoftcapCETilingData); ++i) {
        dst[i] = src[i];
    }
    FusedSoftcapCEBackward op;
    op.Init(gradLoss, sigmoidSaved, logProb, target, gradLogits, data);
    op.Process();
}
